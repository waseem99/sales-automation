{
  "manifest_version": 3,
  "name": "Codistan LinkedIn & Sales Navigator Capture",
  "version": "1.6.1",
  "description": "Capture warm LinkedIn requirements and run route-specific Sales Navigator campaigns for direct buyers, channel partners and delivery partners.",
  "permissions": ["tabs", "storage", "scripting", "alarms"],
  "host_permissions": [
    "https://www.linkedin.com/*",
    "https://sales.linkedin.com/*",
    "http://127.0.0.1:8775/*",
    "http://127.0.0.1:8785/*"
  ],
  "background": {
    "service_worker": "background-entry.js"
  },
  "action": {
    "default_title": "Codistan LinkedIn capture",
    "default_popup": "popup.html"
  },
  "options_page": "sales-nav-options.html",
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/*"],
      "exclude_globs": ["*://www.linkedin.com/sales/*"],
      "js": ["parser-hardening.js", "signal.js", "dom-adapter.js", "search-resolver.js", "content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.linkedin.com/sales/*", "https://sales.linkedin.com/*"],
      "js": ["parser-hardening.js", "sales-nav.js"],
      "run_at": "document_idle"
    }
  ]
}
