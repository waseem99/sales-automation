{
  "manifest_version": 3,
  "name": "Codistan Upwork Opportunity Capture",
  "version": "1.1.0",
  "description": "Capture and qualify jobs from Codistan's approved Upwork saved searches with bounded manual or scheduled scans.",
  "permissions": ["activeTab", "tabs", "storage", "alarms", "scripting"],
  "host_permissions": [
    "https://www.upwork.com/*",
    "http://127.0.0.1:8765/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Codistan Upwork capture",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://www.upwork.com/*"],
      "js": ["evidence.js", "scroll.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
