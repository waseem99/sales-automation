{
  "schema_version": 2,
  "product": "TalentTrack Pilot",
  "product_version": "1.0.0",
  "runtime_version": "0.3.1",
  "release_status": "live_validation",
  "state_root": "%LOCALAPPDATA%\\Codistan\\Acquisition",
  "internal_runtime_package": "acquisition_v4",
  "canonical_commands": {
    "install": "START-HERE-TALENTTRACK.cmd",
    "start": "START-TALENTTRACK.cmd",
    "check": "CHECK-TALENTTRACK.cmd",
    "check_full_pilot": "CHECK-TALENTTRACK-PILOT.cmd",
    "diagnose": "DIAGNOSE-TALENTTRACK.cmd",
    "rollback": "ROLLBACK-TALENTTRACK.cmd",
    "review": "OPEN-TALENTTRACK-REVIEW.cmd",
    "enable_local_postgres": "ENABLE-TALENTTRACK-POSTGRES.cmd",
    "check_local_postgres": "CHECK-TALENTTRACK-POSTGRES.cmd",
    "backup_local_postgres": "BACKUP-TALENTTRACK-POSTGRES.cmd",
    "restore_local_postgres": "RESTORE-TALENTTRACK-POSTGRES.cmd"
  },
  "storage": {
    "default_backend": "jsonl",
    "optional_local_postgres": {
      "status": "live_validation",
      "image": "postgres:16-alpine",
      "host": "127.0.0.1",
      "default_port": 55432,
      "json_rollback_shadow": true,
      "automatic_fallback": false
    },
    "production_prospect_desk": "postgresql"
  },
  "legacy_compatibility": {
    "enabled": true,
    "identifiers": ["Acquisition V4", "Acquisition V5", "Prospecting OS"],
    "reason": "Existing installations, internal modules and desktop shortcuts may still invoke historical names.",
    "removal_policy": "Retain until one accepted pilot upgrade and rollback drill confirms no remaining dependency."
  },
  "collectors": {
    "upwork": {"port": 8765, "status": "live_validation"},
    "linkedin_warm": {"port": 8775, "status": "live_validation"},
    "sales_navigator_cold": {"port": 8785, "status": "live_validation"}
  },
  "extensions": {
    "upwork": {"status": "live_validation"},
    "linkedin_combined": {"version": "1.4.1", "status": "live_validation"}
  },
  "commercial_readiness": {
    "version": "commercial-readiness.v1",
    "server_enforced_before_approval": true,
    "fintech_operations_platform": "research_only",
    "managed_software_ai_delivery": "outreach_ready_limited",
    "unknown_or_unmapped_cold_offers": "blocked"
  },
  "pilot_acceptance": {
    "report": "%LOCALAPPDATA%\\Codistan\\Acquisition\\review\\talenttrack-pilot-acceptance.json",
    "human_review_input": "%LOCALAPPDATA%\\Codistan\\Acquisition\\review\\commercial-review.json",
    "sources": {
      "upwork": {"minimum_records": 100, "minimum_priority_a_b": 15},
      "linkedin_warm": {"minimum_records": 50, "minimum_priority_a_b": 10},
      "sales_navigator": {"minimum_records": 75, "minimum_priority_a_b": 15}
    },
    "minimum_human_reviews": 15,
    "minimum_reviews_per_source": 3,
    "minimum_acceptance_ratio": 0.6,
    "external_action_evidence_allowed": false
  },
  "pilot_operations": {
    "priority_review_queue": true,
    "pilot_blocker_queue": true,
    "warm_and_cold_linkedin_separated": true,
    "required_pursuit_fields": ["owner", "next_action", "due_date", "permitted_channel", "relevant_proof"]
  },
  "external_action_policy": {
    "automatic_sending": false,
    "upwork_submission": false,
    "linkedin_messaging": false,
    "sales_navigator_actions": false
  },
  "merge_policy": {
    "main_requires_live_acceptance": true,
    "consolidated_pull_request_only": true,
    "requires_repository_ci": true,
    "requires_combined_pilot_gate": true,
    "requires_state_preserving_rollback": true
  },
  "upgrade_guarantees": [
    "Preserve captured records and deduplication fingerprints.",
    "Preserve review output and Prospect Desk synchronization configuration.",
    "Preserve outreach revisions, approvals and exact sent-version history.",
    "Preserve the previous application package for rollback.",
    "Preserve the local PostgreSQL volume, secret configuration, backups and JSON rollback shadow.",
    "Do not delete paused or superseded-reference code during installation."
  ]
}
